<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Biometric Attendance Devices List View -->
    <record id="biometric_attendance_devices_view_tree" model="ir.ui.view">
        <field name="name">biometric.attendance.devices.tree</field>
        <field name="model">biometric.attendance.devices</field>
        <field name="arch" type="xml">
            <tree string="Device User Links" editable="bottom" delete="true">
                <field name="employee_id" readonly="1"/>
                <field name="device_id" readonly="1"/>
                <field name="biometric_attendance_id" readonly="1"/>
            </tree>
        </field>
    </record>

    <!-- Biometric Attendance Devices Form View -->
    <record id="biometric_attendance_devices_view_form" model="ir.ui.view">
        <field name="name">biometric.attendance.devices.form</field>
        <field name="model">biometric.attendance.devices</field>
        <field name="arch" type="xml">
            <form string="Device User Link">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="device_id"/>
                        </group>
                        <group>
                            <field name="biometric_attendance_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Biometric Attendance Devices Action -->
    <record id="action_biometric_attendance_devices" model="ir.actions.act_window">
        <field name="name">Device User Links</field>
        <field name="res_model">biometric.attendance.devices</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No device user links found
            </p>
            <p>
                Device user links connect Odoo employees to their corresponding users on biometric devices.
                Use the "Link to Device User" button on the employee form to create new links.
            </p>
        </field>
    </record>
</odoo>
