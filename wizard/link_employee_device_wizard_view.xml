<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Link Employee to Device Wizard Form View -->
    <record id="link_employee_device_wizard_form" model="ir.ui.view">
        <field name="name">link.employee.device.wizard.form</field>
        <field name="model">link.employee.device.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Employee to Device User">
                <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="device_id"/>
                        <button name="action_fetch_device_users"
                                string="Fetch Device Users"
                                type="object"
                                class="oe_highlight"
                                invisible="device_id == False"/>
                    </group>
                    <group>
                        <field name="device_user_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="update_card_number"/>
                    </group>
                </group>
                <footer>
                    <button string="Link" name="action_link_employee" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open the wizard -->
    <record id="action_link_employee_device_wizard" model="ir.actions.act_window">
        <field name="name">Link to Device User</field>
        <field name="res_model">link.employee.device.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
    </record>
</odoo>
